<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.autobank.backup.ui.BackupController"
      spacing="24" styleClass="content-pane"
      xmlns="http://javafx.com/javafx/22">

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="16">
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="%backup.title" styleClass="page-title"/>
            <Label text="%backup.subtitle" styleClass="page-subtitle"/>
        </VBox>
        <Button fx:id="openDirBtn" text="%backup.button.open_dir"
                onAction="#handleOpenDir" styleClass="secondary-button" prefHeight="40"/>
        <Button text="🔄 Refresh" onAction="#handleRefresh" styleClass="primary-button" prefHeight="40"/>
    </HBox>

    <!-- Status bar -->
    <HBox alignment="CENTER_LEFT" spacing="14" styleClass="info-banner">
        <Label text="💾" style="-fx-font-size: 18px;"/>
        <Label fx:id="statusLabel" text="%backup.label.loading"
               style="-fx-font-size: 12px; -fx-font-weight: bold;" HBox.hgrow="ALWAYS"/>
        <Label fx:id="backupDirLabel"
               style="-fx-font-size: 11px; -fx-font-family: 'Consolas', monospace; -fx-text-fill: #94a3b8;"/>
    </HBox>

    <!-- Main two-column area -->
    <HBox spacing="24" VBox.vgrow="ALWAYS">

        <!-- LEFT: Backup list -->
        <VBox spacing="16" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS" styleClass="chart-card">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label text="%backup.section.available" styleClass="section-title" HBox.hgrow="ALWAYS"/>
                <Label text="%backup.label.newest_first" styleClass="status-label"/>
            </HBox>
            <Separator/>
            <ListView fx:id="backupListView" VBox.vgrow="ALWAYS"
                      style="-fx-background-color: transparent; -fx-border-color: transparent;"/>
            <!-- Actions -->
            <HBox spacing="12">
                <Button fx:id="restoreBtn" text="%backup.button.restore"
                        onAction="#handleRestore"
                        styleClass="success-button" HBox.hgrow="ALWAYS" maxWidth="Infinity" prefHeight="42"/>
                <Button text="%backup.button.restore_file"
                        onAction="#handleRestoreFromFile"
                        styleClass="primary-button" HBox.hgrow="ALWAYS" maxWidth="Infinity" prefHeight="42"/>
                <Button text="%backup.button.delete"
                        onAction="#handleDeleteSelected"
                        styleClass="danger-button" prefHeight="42"/>
            </HBox>
        </VBox>

        <!-- RIGHT: Controls -->
        <VBox spacing="24" minWidth="280" styleClass="chart-card">

            <!-- Manual backup -->
            <VBox spacing="12">
                <Label text="%backup.section.manual" styleClass="section-title"/>
                <Separator/>
                <Label text="%backup.label.manual_desc"
                       styleClass="page-subtitle" wrapText="true"/>
                <Button fx:id="backupNowBtn" text="%backup.button.now"
                        onAction="#handleBackupNow"
                        styleClass="primary-button" maxWidth="Infinity" prefHeight="44"/>
            </VBox>

            <!-- Auto-schedule -->
            <VBox spacing="12">
                <Label text="%backup.section.auto" styleClass="section-title"/>
                <Separator/>
                <Label fx:id="scheduledTimeLabel" style="-fx-font-size: 12px; -fx-font-weight: bold;"/>
                <Label text="%backup.label.set_time" styleClass="page-subtitle"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <VBox spacing="6">
                        <Label text="%backup.label.hour" styleClass="stat-label"/>
                        <TextField fx:id="scheduleHourField" maxWidth="64"
                                   promptText="HH"
                                   style="-fx-font-size: 16px; -fx-alignment: center;"/>
                    </VBox>
                    <Label text=":" style="-fx-font-size: 22px; -fx-padding: 18 0 0 0; -fx-text-fill: #94a3b8;"/>
                    <VBox spacing="6">
                        <Label text="%backup.label.min" styleClass="stat-label"/>
                        <TextField fx:id="scheduleMinuteField" maxWidth="64"
                                   promptText="MM"
                                   style="-fx-font-size: 16px; -fx-alignment: center;"/>
                    </VBox>
                    <Button text="⏰ Save"
                            onAction="#handleSaveSchedule"
                            styleClass="success-button"
                            style="-fx-padding: 10px 16px; -fx-translate-y: 10px;"/>
                </HBox>
            </VBox>

            <!-- Info box -->
            <VBox spacing="10" VBox.vgrow="ALWAYS" styleClass="info-banner">
                <Label text="%backup.section.info" style="-fx-text-fill: #10b981; -fx-font-weight: bold; -fx-font-size: 13px;"/>
                <Label text="• Saves to: ~/AutoBank/backups/" styleClass="status-label" wrapText="true"/>
                <Label text="• Format: .sql.gz (compressed)" styleClass="status-label"/>
                <Label text="• Last 10 backups auto-retained" styleClass="status-label" wrapText="true"/>
                <Label text="• Uses mysqldump or JDBC fallback" styleClass="status-label" wrapText="true"/>
                <Label text="• Auto-backup runs daily at scheduled time" styleClass="status-label" wrapText="true"/>
            </VBox>
        </VBox>
    </HBox>
</VBox>
