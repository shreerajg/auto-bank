<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.autobank.backup.ui.BackupController"
      spacing="20" styleClass="content-pane"
      xmlns="http://javafx.com/javafx/22">

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="12">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="%backup.title" styleClass="page-title"/>
            <Label text="%backup.subtitle"
                   style="-fx-font-size: 12px; -fx-text-fill: #6b7280;"/>
        </VBox>
        <Button fx:id="openDirBtn" text="%backup.button.open_dir"
                onAction="#handleOpenDir" styleClass="primary-button"/>
        <Button text="🔄  %common.refresh" onAction="#handleRefresh" styleClass="primary-button"/>
    </HBox>

    <!-- Status bar -->
    <HBox alignment="CENTER_LEFT" spacing="12"
          style="-fx-background-color: rgba(99,102,241,0.08); -fx-padding: 10px 16px; -fx-background-radius: 8px; -fx-border-color: rgba(99,102,241,0.2); -fx-border-radius: 8px;">
        <Label text="💾" style="-fx-font-size: 16px;"/>
        <Label fx:id="statusLabel" text="%backup.label.loading"
               style="-fx-text-fill: #818cf8; -fx-font-size: 12px;"/>
        <Pane HBox.hgrow="ALWAYS"/>
        <Label fx:id="backupDirLabel"
               style="-fx-text-fill: #4b5563; -fx-font-size: 11px; -fx-font-family: 'Consolas', monospace;"/>
    </HBox>

    <!-- Main two-column area -->
    <HBox spacing="20" VBox.vgrow="ALWAYS">

        <!-- LEFT: Backup list -->
        <VBox spacing="12" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS"
              style="-fx-background-color: #161b27; -fx-padding: 20px; -fx-background-radius: 12px; -fx-border-color: rgba(255,255,255,0.07); -fx-border-radius: 12px;">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="%backup.section.available" styleClass="section-title" HBox.hgrow="ALWAYS"/>
                <Label text="%backup.label.newest_first" style="-fx-text-fill: #4b5563; -fx-font-size: 11px;"/>
            </HBox>
            <Separator/>
            <ListView fx:id="backupListView" VBox.vgrow="ALWAYS"
                      style="-fx-background-color: transparent; -fx-border-color: transparent;"/>
            <!-- Actions -->
            <HBox spacing="10">
                <Button fx:id="restoreBtn" text="%backup.button.restore"
                        onAction="#handleRestore"
                        styleClass="success-button" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Button text="%backup.button.restore_file"
                        onAction="#handleRestoreFromFile"
                        styleClass="primary-button" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Button text="%backup.button.delete"
                        onAction="#handleDeleteSelected"
                        styleClass="danger-button"/>
            </HBox>
        </VBox>

        <!-- RIGHT: Controls -->
        <VBox spacing="16" minWidth="270"
              style="-fx-background-color: #161b27; -fx-padding: 20px; -fx-background-radius: 12px; -fx-border-color: rgba(255,255,255,0.07); -fx-border-radius: 12px;">

            <!-- Manual backup -->
            <VBox spacing="10">
                <Label text="%backup.section.manual" styleClass="section-title"/>
                <Separator/>
                <Label text="%backup.label.manual_desc"
                       style="-fx-text-fill: #6b7280; -fx-font-size: 12px;" wrapText="true"/>
                <Button fx:id="backupNowBtn" text="%backup.button.now"
                        onAction="#handleBackupNow"
                        styleClass="primary-button" maxWidth="Infinity"/>
            </VBox>

            <!-- Auto-schedule -->
            <VBox spacing="10">
                <Label text="%backup.section.auto" styleClass="section-title"/>
                <Separator/>
                <Label fx:id="scheduledTimeLabel"
                       style="-fx-text-fill: #818cf8; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                <Label text="%backup.label.set_time"
                       style="-fx-text-fill: #6b7280; -fx-font-size: 12px;"/>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <VBox spacing="4">
                        <Label text="%backup.label.hour" style="-fx-font-size: 10px; -fx-text-fill: #6b7280;"/>
                        <TextField fx:id="scheduleHourField" maxWidth="60"
                                   promptText="HH"
                                   style="-fx-background-color: #1e2535; -fx-text-fill: #e5e7eb; -fx-border-color: rgba(255,255,255,0.1); -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-padding: 6px; -fx-font-size: 14px; -fx-alignment: center;"/>
                    </VBox>
                    <Label text=":" style="-fx-text-fill: #6b7280; -fx-font-size: 20px; -fx-padding: 16px 0 0 0;"/>
                    <VBox spacing="4">
                        <Label text="%backup.label.min" style="-fx-font-size: 10px; -fx-text-fill: #6b7280;"/>
                        <TextField fx:id="scheduleMinuteField" maxWidth="60"
                                   promptText="MM"
                                   style="-fx-background-color: #1e2535; -fx-text-fill: #e5e7eb; -fx-border-color: rgba(255,255,255,0.1); -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-padding: 6px; -fx-font-size: 14px; -fx-alignment: center;"/>
                    </VBox>
                    <Button text="⏰  %common.save"
                            onAction="#handleSaveSchedule"
                            styleClass="success-button"
                            style="-fx-padding: 8px 16px; -fx-translate-y: 8px;"/>
                </HBox>
            </VBox>

            <!-- Info box -->
            <VBox spacing="8" VBox.vgrow="ALWAYS"
                  style="-fx-background-color: rgba(16,185,129,0.06); -fx-padding: 14px; -fx-background-radius: 8px; -fx-border-color: rgba(16,185,129,0.15); -fx-border-radius: 8px;">
                <Label text="%backup.section.info" style="-fx-text-fill: #34d399; -fx-font-weight: bold; -fx-font-size: 12px;"/>
                <Label text="• Backups saved to: ~/AutoBank/backups/"
                       style="-fx-text-fill: #6b7280; -fx-font-size: 11px;" wrapText="true"/>
                <Label text="• Format: .sql.gz (compressed)"
                       style="-fx-text-fill: #6b7280; -fx-font-size: 11px;"/>
                <Label text="• Last 10 backups are kept automatically"
                       style="-fx-text-fill: #6b7280; -fx-font-size: 11px;" wrapText="true"/>
                <Label text="• Uses mysqldump if available, JDBC otherwise"
                       style="-fx-text-fill: #6b7280; -fx-font-size: 11px;" wrapText="true"/>
                <Label text="• Auto-backup runs daily at the scheduled time"
                       style="-fx-text-fill: #6b7280; -fx-font-size: 11px;" wrapText="true"/>
            </VBox>
        </VBox>
    </HBox>
</VBox>
