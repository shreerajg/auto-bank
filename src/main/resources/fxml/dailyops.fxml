<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.autobank.dailyops.ui.DailyOpsController"
      spacing="20" styleClass="content-pane"
      xmlns="http://javafx.com/javafx/22">

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="12">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Daily Operations" styleClass="page-title"/>
            <Label fx:id="todayDateLabel" styleClass="page-subtitle"/>
        </VBox>
    </HBox>

    <!-- Top cards row -->
    <HBox spacing="16">

        <!-- Day Status Card -->
        <VBox spacing="14" styleClass="form-panel" HBox.hgrow="ALWAYS">
            <Label text="Today's Status" styleClass="section-title"/>
            <Separator/>
            <HBox spacing="0">
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="SESSION" styleClass="stat-label"/>
                    <Label fx:id="sessionStatusLabel" text="—" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #0f172a;"/>
                </VBox>
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="OPENING BALANCE" styleClass="stat-label"/>
                    <Label fx:id="openingBalLabel" text="—" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #0f172a;"/>
                </VBox>
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="EXPECTED CASH" styleClass="stat-label"/>
                    <Label fx:id="expectedCashLabel" text="—" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #059669;"/>
                </VBox>
            </HBox>
        </VBox>

        <!-- Open Day Card -->
        <VBox spacing="12" styleClass="form-panel" HBox.hgrow="ALWAYS">
            <Label text="Open Day" styleClass="section-title"/>
            <Separator/>
            <VBox spacing="6">
                <Label text="OPENING CASH (₹)" styleClass="stat-label"/>
                <TextField fx:id="openingBalField" promptText="Cash on hand at opening"/>
            </VBox>
            <Button fx:id="openDayBtn" text="▶  Open Day" onAction="#handleOpenDay"
                    styleClass="success-button" maxWidth="Infinity" prefHeight="40"/>
        </VBox>

        <!-- Close Day Card -->
        <VBox spacing="12" styleClass="form-panel" HBox.hgrow="ALWAYS">
            <Label text="Close Day" styleClass="section-title"/>
            <Separator/>
            <VBox spacing="6">
                <Label text="ACTUAL CASH IN HAND (₹)" styleClass="stat-label"/>
                <TextField fx:id="actualCashField" promptText="Count and enter cash"/>
            </VBox>
            <Button fx:id="closeDayBtn" text="■  Close Day" onAction="#handleCloseDay"
                    styleClass="danger-button" maxWidth="Infinity" prefHeight="40"/>
        </VBox>

    </HBox>

    <Label fx:id="statusLabel" styleClass="status-label" wrapText="true"/>

    <!-- History -->
    <VBox spacing="10">
        <Label text="Session History — Last 30 Days" styleClass="section-title"/>
        <TableView fx:id="historyTable" VBox.vgrow="ALWAYS" prefHeight="320">
            <columns>
                <TableColumn fx:id="colDate"          text="Date"              prefWidth="120"/>
                <TableColumn fx:id="colOpening"       text="Opening Bal (₹)"   prefWidth="140"/>
                <TableColumn fx:id="colExpected"      text="Expected Cash (₹)" prefWidth="150"/>
                <TableColumn fx:id="colActual"        text="Actual Cash (₹)"   prefWidth="140"/>
                <TableColumn fx:id="colSessionStatus" text="Status"            prefWidth="90"/>
            </columns>
        </TableView>
    </VBox>

</VBox>
