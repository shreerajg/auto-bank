<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.autobank.dailyops.ui.DailyOpsController"
      spacing="20" styleClass="content-pane"
      xmlns="http://javafx.com/javafx/22">

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="12">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="%dailyops.title" styleClass="page-title"/>
            <Label fx:id="todayDateLabel" styleClass="page-subtitle"/>
        </VBox>
    </HBox>

    <!-- Top cards row -->
    <HBox spacing="16">

        <!-- Day Status Card -->
        <VBox spacing="14" styleClass="form-panel" HBox.hgrow="ALWAYS">
            <Label text="%dailyops.status.title" styleClass="section-title"/>
            <Separator/>
            <HBox spacing="0">
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="%dailyops.label.session" styleClass="stat-label"/>
                    <Label fx:id="sessionStatusLabel" text="—" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #0f172a;"/>
                </VBox>
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="%dailyops.label.opening_bal" styleClass="stat-label"/>
                    <Label fx:id="openingBalLabel" text="—" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #0f172a;"/>
                </VBox>
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="%dailyops.label.expected_cash" styleClass="stat-label"/>
                    <Label fx:id="expectedCashLabel" text="—" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #059669;"/>
                </VBox>
            </HBox>
        </VBox>

        <!-- Open Day Card -->
        <VBox spacing="12" styleClass="form-panel" HBox.hgrow="ALWAYS">
            <Label text="%dailyops.section.open" styleClass="section-title"/>
            <Separator/>
            <VBox spacing="6">
                <Label text="%dailyops.label.opening_cash" styleClass="stat-label"/>
                <TextField fx:id="openingBalField" promptText="%dailyops.label.opening_cash"/>
            </VBox>
            <Button fx:id="openDayBtn" text="%dailyops.button.open" onAction="#handleOpenDay"
                    styleClass="success-button" maxWidth="Infinity" prefHeight="40"/>
        </VBox>

        <!-- Close Day Card -->
        <VBox spacing="12" styleClass="form-panel" HBox.hgrow="ALWAYS">
            <Label text="%dailyops.section.close" styleClass="section-title"/>
            <Separator/>
            <VBox spacing="6">
                <Label text="%dailyops.label.actual_cash" styleClass="stat-label"/>
                <TextField fx:id="actualCashField" promptText="%dailyops.label.actual_cash"/>
            </VBox>
            <Button fx:id="closeDayBtn" text="%dailyops.button.close" onAction="#handleCloseDay"
                    styleClass="danger-button" maxWidth="Infinity" prefHeight="40"/>
        </VBox>

    </HBox>

    <Label fx:id="statusLabel" styleClass="status-label" wrapText="true"/>

    <!-- History -->
    <VBox spacing="10">
        <Label text="%dailyops.history.title" styleClass="section-title"/>
        <TableView fx:id="historyTable" VBox.vgrow="ALWAYS" prefHeight="320">
            <columns>
                <TableColumn fx:id="colDate"          text="%dailyops.table.date"              prefWidth="120"/>
                <TableColumn fx:id="colOpening"       text="%dailyops.table.opening"   prefWidth="140"/>
                <TableColumn fx:id="colExpected"      text="%dailyops.table.expected" prefWidth="150"/>
                <TableColumn fx:id="colActual"        text="%dailyops.table.actual"   prefWidth="140"/>
                <TableColumn fx:id="colSessionStatus" text="%accounts.table.status"            prefWidth="90"/>
            </columns>
        </TableView>
    </VBox>

</VBox>
