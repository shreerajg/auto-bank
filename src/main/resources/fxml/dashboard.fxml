<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.*?>

<ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: app-bg-base;" 
          xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
          fx:controller="com.autobank.ui.DashboardController">
    <VBox fx:id="mainContainer" spacing="36" styleClass="content-pane">
        
        <!-- Header -->
        <HBox alignment="CENTER_LEFT" spacing="16">
            <VBox spacing="8">
                <Label fx:id="dashboardTitle" text="%dashboard.title" styleClass="page-title"/>
                <Label fx:id="dashboardSubtitle" text="%dashboard.subtitle" styleClass="page-subtitle"/>
            </VBox>
        </HBox>

        <!-- Stat Cards Row -->
        <HBox spacing="24">
            <VBox styleClass="stat-card, stat-card-blue" spacing="14" HBox.hgrow="ALWAYS">
                <Label fx:id="totalAccountsHeader" text="%dashboard.stats.accounts" styleClass="stat-label"/>
                <Label fx:id="totalAccountsLabel" text="—" styleClass="stat-value"/>
                <Label text="%dashboard.stats.accounts_sub" styleClass="stat-subtext"/>
            </VBox>
            <VBox styleClass="stat-card, stat-card-green" spacing="14" HBox.hgrow="ALWAYS">
                <Label fx:id="totalBalanceHeader" text="%dashboard.stats.balance" styleClass="stat-label"/>
                <Label fx:id="totalBalanceLabel" text="—" styleClass="stat-value"/>
                <Label text="%dashboard.stats.balance_sub" styleClass="stat-subtext"/>
            </VBox>
            <VBox styleClass="stat-card, stat-card-purple" spacing="14" HBox.hgrow="ALWAYS">
                <Label fx:id="activeLoansHeader" text="%dashboard.stats.loans" styleClass="stat-label"/>
                <Label fx:id="activeLoansLabel" text="—" styleClass="stat-value"/>
                <Label text="%dashboard.stats.loans_sub" styleClass="stat-subtext"/>
            </VBox>
            <VBox styleClass="stat-card, stat-card-orange" spacing="14" HBox.hgrow="ALWAYS">
                <Label fx:id="todayTxHeader" text="%dashboard.stats.today" styleClass="stat-label"/>
                <Label fx:id="todayTxLabel" text="—" styleClass="stat-value"/>
                <Label text="%dashboard.stats.today_sub" styleClass="stat-subtext"/>
            </VBox>
        </HBox>

        <!-- Quick Actions Row -->
        <VBox spacing="18">
            <Label text="Quick Actions" styleClass="section-title"/>
            <HBox spacing="24">
                <VBox styleClass="quick-action-card" spacing="6" HBox.hgrow="ALWAYS" onMouseClicked="#handleNewAccount">
                    <Label text="👤" styleClass="quick-action-icon"/>
                    <Label text="New Account" styleClass="quick-action-title"/>
                    <Label text="Register a new customer or farmer" styleClass="quick-action-desc"/>
                </VBox>
                <VBox styleClass="quick-action-card" spacing="6" HBox.hgrow="ALWAYS" onMouseClicked="#handleDeposit">
                    <Label text="💰" styleClass="quick-action-icon"/>
                    <Label text="Cash Deposit" styleClass="quick-action-title"/>
                    <Label text="Add money to an existing account" styleClass="quick-action-desc"/>
                </VBox>
                <VBox styleClass="quick-action-card" spacing="6" HBox.hgrow="ALWAYS" onMouseClicked="#handleWithdraw">
                    <Label text="🏧" styleClass="quick-action-icon"/>
                    <Label text="Withdrawal" styleClass="quick-action-title"/>
                    <Label text="Debit money from an account" styleClass="quick-action-desc"/>
                </VBox>
            </HBox>
        </VBox>

        <!-- Charts Row 1: Transaction Trends and Loan Distribution -->
        <HBox spacing="28">
            <!-- Transaction Trend Chart -->
            <VBox styleClass="chart-card" HBox.hgrow="ALWAYS">
                <Label text="%dashboard.chart.title" styleClass="chart-title"/>
                <BarChart fx:id="txChart" prefHeight="320" animated="false">
                    <xAxis><CategoryAxis side="BOTTOM" /></xAxis>
                    <yAxis><NumberAxis side="LEFT" /></yAxis>
                </BarChart>
            </VBox>

            <!-- Loan Distribution Pie Chart -->
            <VBox styleClass="chart-card" prefWidth="380">
                <Label text="Loan Distribution" styleClass="chart-title"/>
                <PieChart fx:id="loanPieChart" prefHeight="320" animated="true"/>
            </VBox>
        </HBox>

        <!-- Charts Row 2: Cash Flow and Recent Activity -->
        <HBox spacing="28">
            <!-- Cash Flow Line Chart -->
            <VBox styleClass="chart-card" HBox.hgrow="ALWAYS">
                <Label text="Monthly Cash Flow" styleClass="chart-title"/>
                <LineChart fx:id="cashFlowChart" prefHeight="320" animated="false">
                    <xAxis><CategoryAxis side="BOTTOM" /></xAxis>
                    <yAxis><NumberAxis side="LEFT" /></yAxis>
                </LineChart>
            </VBox>

            <!-- Recent Activity Table -->
            <VBox styleClass="chart-card" prefWidth="420">
                <Label text="%dashboard.recent.title" styleClass="chart-title"/>
                <TableView fx:id="recentTable" VBox.vgrow="ALWAYS" prefHeight="320">
                    <columns>
                        <TableColumn fx:id="colType" text="%dashboard.recent.type" prefWidth="110"/>
                        <TableColumn fx:id="colAmount" text="%dashboard.recent.amount" prefWidth="140"/>
                        <TableColumn fx:id="colDate" text="%dashboard.recent.time" prefWidth="160"/>
                    </columns>
                </TableView>
            </VBox>
        </HBox>

        <!-- Quick info bar -->
        <HBox spacing="16" alignment="CENTER_LEFT" styleClass="info-banner">
            <Label text="💡" styleClass="info-banner-icon"/>
            <Label text="%dashboard.info.offline" styleClass="info-banner-text"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <Label fx:id="systemStatusLabel" text="%dashboard.info.operational" styleClass="info-banner-status"/>
        </HBox>
    </VBox>
</ScrollPane>
