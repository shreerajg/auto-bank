<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.*?>

<ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: #f0f2f5;" 
          xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.autobank.ui.DashboardController">
    <VBox spacing="32" styleClass="content-pane">
        
        <!-- Header -->
        <HBox alignment="CENTER_LEFT" spacing="16">
            <VBox spacing="6">
                <Label fx:id="dashboardTitle" text="Dashboard" styleClass="page-title"/>
                <Label fx:id="dashboardSubtitle" text="Overview of your cooperative banking activity" styleClass="page-subtitle"/>
            </VBox>
        </HBox>

        <!-- Stat Cards Row -->
        <HBox spacing="20">
            <VBox styleClass="stat-card, stat-card-blue" spacing="12" HBox.hgrow="ALWAYS">
                <Label fx:id="totalAccountsHeader" text="TOTAL ACCOUNTS" styleClass="stat-label"/>
                <Label fx:id="totalAccountsLabel" text="—" styleClass="stat-value"/>
                <Label text="Active members" styleClass="stat-subtext"/>
            </VBox>
            <VBox styleClass="stat-card, stat-card-green" spacing="12" HBox.hgrow="ALWAYS">
                <Label fx:id="totalBalanceHeader" text="TOTAL BALANCE" styleClass="stat-label"/>
                <Label fx:id="totalBalanceLabel" text="—" styleClass="stat-value"/>
                <Label text="Funds under management" styleClass="stat-subtext"/>
            </VBox>
            <VBox styleClass="stat-card, stat-card-purple" spacing="12" HBox.hgrow="ALWAYS">
                <Label fx:id="activeLoansHeader" text="ACTIVE LOANS" styleClass="stat-label"/>
                <Label fx:id="activeLoansLabel" text="—" styleClass="stat-value"/>
                <Label text="Outstanding loan accounts" styleClass="stat-subtext"/>
            </VBox>
            <VBox styleClass="stat-card, stat-card-orange" spacing="12" HBox.hgrow="ALWAYS">
                <Label fx:id="todayTxHeader" text="TODAY'S TRANSACTIONS" styleClass="stat-label"/>
                <Label fx:id="todayTxLabel" text="—" styleClass="stat-value"/>
                <Label text="Deposits &amp; withdrawals" styleClass="stat-subtext"/>
            </VBox>
        </HBox>

        <!-- Charts and Activity Row -->
        <HBox spacing="24">
            <!-- Transaction Trend Chart -->
            <VBox styleClass="chart-card" HBox.hgrow="ALWAYS" prefWidth="600">
                <Label text="Transaction Trends (Last 7 Days)" styleClass="chart-title"/>
                <BarChart fx:id="txChart" prefHeight="300" animated="false">
                    <xAxis><CategoryAxis side="BOTTOM" /></xAxis>
                    <yAxis><NumberAxis side="LEFT" /></yAxis>
                </BarChart>
            </VBox>

            <!-- Recent Activity Table -->
            <VBox styleClass="chart-card" prefWidth="400">
                <Label text="Recent Activity" styleClass="chart-title"/>
                <TableView fx:id="recentTable" VBox.vgrow="ALWAYS" prefHeight="300">
                    <columns>
                        <TableColumn fx:id="colType" text="Type" prefWidth="100"/>
                        <TableColumn fx:id="colAmount" text="Amount" prefWidth="120"/>
                        <TableColumn fx:id="colDate" text="Time" prefWidth="150"/>
                    </columns>
                </TableView>
            </VBox>
        </HBox>

        <!-- Quick info bar -->
        <HBox spacing="16" alignment="CENTER_LEFT" styleClass="info-banner">
            <Label text="💡" styleClass="info-banner-icon"/>
            <Label text="System is running in offline mode — all data is stored locally." styleClass="info-banner-text"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <Label fx:id="systemStatusLabel" text="● Operational" styleClass="info-banner-status"/>
        </HBox>
    </VBox>
</ScrollPane>
