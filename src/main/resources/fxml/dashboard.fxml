<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.autobank.ui.DashboardController"
      spacing="32" styleClass="content-pane"
      xmlns="http://javafx.com/javafx/22">

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="16">
        <VBox spacing="6">
            <Label text="Dashboard" styleClass="page-title"/>
            <Label text="Overview of your cooperative banking activity" styleClass="page-subtitle"/>
        </VBox>
    </HBox>

    <!-- Stat Cards Row -->
    <HBox spacing="20">
        <VBox styleClass="stat-card, stat-card-blue" spacing="12" HBox.hgrow="ALWAYS">
            <Label text="TOTAL ACCOUNTS" styleClass="stat-label"/>
            <Label fx:id="totalAccountsLabel" text="—" styleClass="stat-value"/>
            <Label text="Active members" styleClass="stat-subtext"/>
        </VBox>
        <VBox styleClass="stat-card, stat-card-green" spacing="12" HBox.hgrow="ALWAYS">
            <Label text="TOTAL BALANCE" styleClass="stat-label"/>
            <Label fx:id="totalBalanceLabel" text="—" styleClass="stat-value"/>
            <Label text="Funds under management" styleClass="stat-subtext"/>
        </VBox>
        <VBox styleClass="stat-card, stat-card-purple" spacing="12" HBox.hgrow="ALWAYS">
            <Label text="ACTIVE LOANS" styleClass="stat-label"/>
            <Label fx:id="activeLoansLabel" text="—" styleClass="stat-value"/>
            <Label text="Outstanding loan accounts" styleClass="stat-subtext"/>
        </VBox>
        <VBox styleClass="stat-card, stat-card-orange" spacing="12" HBox.hgrow="ALWAYS">
            <Label text="TODAY'S TRANSACTIONS" styleClass="stat-label"/>
            <Label fx:id="todayTxLabel" text="—" styleClass="stat-value"/>
            <Label text="Deposits &amp; withdrawals" styleClass="stat-subtext"/>
        </VBox>
    </HBox>

    <!-- Quick info bar -->
    <HBox spacing="16" alignment="CENTER_LEFT" styleClass="info-banner">
        <Label text="💡" styleClass="info-banner-icon"/>
        <Label text="System is running in offline mode — all data is stored locally." styleClass="info-banner-text"/>
        <Pane HBox.hgrow="ALWAYS"/>
        <Label fx:id="systemStatusLabel" text="● Operational" styleClass="info-banner-status"/>
    </HBox>
</VBox>
