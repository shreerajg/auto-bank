<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="20" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.autobank.distribution.ui.DistributionController"
      styleClass="content-pane">

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="12">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Payment Distribution" styleClass="page-title"/>
            <Label text="Import dairy payment files and bulk-credit member accounts" styleClass="page-subtitle"/>
        </VBox>
        <Button text="📥  Import Excel / PDF" onAction="#handleImport" styleClass="primary-button"/>
    </HBox>

    <!-- Main card -->
    <VBox spacing="14" VBox.vgrow="ALWAYS" styleClass="card">

        <HBox alignment="CENTER_LEFT" spacing="12">
            <Label fx:id="statusLabel" text="Import a file to start distribution"
                   styleClass="status-label" HBox.hgrow="ALWAYS"/>
            <Button fx:id="processBtn" text="✔  Process Credits"
                    onAction="#handleProcess" disable="true" styleClass="success-button"/>
        </HBox>

        <Separator/>

        <TableView fx:id="recordTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colName"   text="Name"          prefWidth="200"/>
                <TableColumn fx:id="colAcc"    text="Account #"     prefWidth="130"/>
                <TableColumn fx:id="colAmount" text="Amount (₹)"    prefWidth="120"/>
                <TableColumn fx:id="colStatus" text="Status"        prefWidth="110"/>
                <TableColumn fx:id="colError"  text="Error / Note"  prefWidth="300"/>
            </columns>
        </TableView>

    </VBox>
</VBox>
