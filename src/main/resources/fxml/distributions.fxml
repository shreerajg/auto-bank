<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="20" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.autobank.distribution.ui.DistributionController"
      styleClass="content-pane">

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="12">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="%dist.title" styleClass="page-title"/>
            <Label text="%dist.subtitle" styleClass="page-subtitle"/>
        </VBox>
        <Button text="%dist.button.import" onAction="#handleImport" styleClass="primary-button"/>
    </HBox>

    <!-- Main card -->
    <VBox spacing="14" VBox.vgrow="ALWAYS" styleClass="card">

        <HBox alignment="CENTER_LEFT" spacing="12">
            <Label fx:id="statusLabel" text="%dist.label.start"
                   styleClass="status-label" HBox.hgrow="ALWAYS"/>
            <Button fx:id="processBtn" text="%dist.button.process"
                    onAction="#handleProcess" disable="true" styleClass="success-button"/>
        </HBox>

        <Separator/>

        <TableView fx:id="recordTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colName"   text="%accounts.table.name"          prefWidth="200"/>
                <TableColumn fx:id="colAcc"    text="%accounts.table.acc_no"     prefWidth="130"/>
                <TableColumn fx:id="colAmount" text="%tx.table.amount"    prefWidth="120"/>
                <TableColumn fx:id="colStatus" text="%accounts.table.status"        prefWidth="110"/>
                <TableColumn fx:id="colError"  text="%dist.table.error"  prefWidth="300"/>
            </columns>
        </TableView>

    </VBox>
</VBox>
