<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox spacing="28" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.autobank.interest.ui.InterestController" styleClass="content-pane">
    <padding>
        <Insets bottom="32" left="40" right="40" top="32" />
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="16">
        <VBox HBox.hgrow="ALWAYS">
            <Label text="%interest.title" styleClass="page-title"/>
            <Label text="%interest.subtitle" styleClass="page-subtitle" />
        </VBox>
    </HBox>

    <Separator/>

    <VBox spacing="20" styleClass="form-panel">
        <GridPane hgap="28" vgap="18" maxWidth="600">
            <columnConstraints>
                <ColumnConstraints minWidth="120" prefWidth="140" />
                <ColumnConstraints hgrow="ALWAYS" minWidth="220" />
            </columnConstraints>

            <Label text="%interest.label.year" styleClass="stat-label" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <ComboBox fx:id="yearCombo" prefWidth="180" prefHeight="40" GridPane.columnIndex="1" GridPane.rowIndex="0" />

            <Label text="%interest.label.month" styleClass="stat-label" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <ComboBox fx:id="monthCombo" prefWidth="180" prefHeight="40" GridPane.columnIndex="1" GridPane.rowIndex="1" />

            <Label text="%interest.label.type" styleClass="stat-label" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <HBox spacing="18" alignment="CENTER_LEFT" GridPane.columnIndex="1" GridPane.rowIndex="2">
                <RadioButton fx:id="savingsRadio" text="%interest.type.savings" selected="true" style="-fx-font-size: 13px;">
                    <toggleGroup><ToggleGroup fx:id="batchTypeGroup"/></toggleGroup>
                </RadioButton>
                <RadioButton fx:id="loanRadio" text="%interest.type.loans" toggleGroup="$batchTypeGroup" style="-fx-font-size: 13px;" />
            </HBox>
        </GridPane>

        <HBox spacing="14">
            <Button fx:id="previewBtn" onAction="#handlePreview" text="%interest.button.preview" styleClass="primary-button" prefWidth="160" prefHeight="44" />
            <Button fx:id="executeBtn" onAction="#handleExecute" text="%interest.button.execute" styleClass="danger-button" prefWidth="160" prefHeight="44" disable="true" />
        </HBox>
    </VBox>

    <VBox fx:id="previewArea" spacing="16" visible="false" styleClass="info-banner">
        <Label text="%interest.preview.title" style="-fx-font-weight: bold; -fx-font-size: 14px;" />
        <GridPane hgap="28" vgap="12">
            <Label text="%interest.preview.count" GridPane.rowIndex="0" GridPane.columnIndex="0" />
            <Label fx:id="countLabel" text="0" style="-fx-font-weight: bold; -fx-font-size: 16px;" GridPane.rowIndex="0" GridPane.columnIndex="1" />
            
            <Label text="%interest.preview.total" GridPane.rowIndex="1" GridPane.columnIndex="0" />
            <Label fx:id="totalAmountLabel" text="₹ 0.00" style="-fx-font-weight: bold; -fx-font-size: 18px; -fx-text-fill: #10b981;" GridPane.rowIndex="1" GridPane.columnIndex="1" />
        </GridPane>
        <Label text="%interest.preview.warning" style="-fx-text-fill: #f59e0b; -fx-font-size: 12px;" />
    </VBox>

    <VBox fx:id="statusArea" spacing="8" />

</VBox>
