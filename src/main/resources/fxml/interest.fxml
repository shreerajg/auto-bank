<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox spacing="20.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.autobank.interest.ui.InterestController" styleClass="content-area">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="15.0">
        <VBox HBox.hgrow="ALWAYS">
            <Label text="%interest.title" styleClass="header-title">
                <font><Font name="System Bold" size="24.0" /></font>
            </Label>
            <Label text="%interest.subtitle" styleClass="header-subtitle" />
        </VBox>
    </HBox>

    <Separator />

    <GridPane hgap="20.0" vgap="15.0" maxWidth="600.0">
        <columnConstraints>
            <ColumnConstraints minWidth="100.0" prefWidth="120.0" />
            <ColumnConstraints hgrow="ALWAYS" minWidth="200.0" />
        </columnConstraints>

        <Label text="%interest.label.year" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <ComboBox fx:id="yearCombo" prefWidth="150.0" GridPane.columnIndex="1" GridPane.rowIndex="0" />

        <Label text="%interest.label.month" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <ComboBox fx:id="monthCombo" prefWidth="150.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <Label text="%interest.label.type" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <HBox spacing="15.0" alignment="CENTER_LEFT" GridPane.columnIndex="1" GridPane.rowIndex="2">
            <RadioButton fx:id="savingsRadio" text="%interest.type.savings" selected="true">
                <toggleGroup><ToggleGroup fx:id="batchTypeGroup"/></toggleGroup>
            </RadioButton>
            <RadioButton fx:id="loanRadio" text="%interest.type.loans" toggleGroup="$batchTypeGroup" />
        </HBox>
    </GridPane>

    <HBox spacing="15.0">
        <Button fx:id="previewBtn" onAction="#handlePreview" text="%interest.button.preview" styleClass="button-primary" prefWidth="150.0" />
        <Button fx:id="executeBtn" onAction="#handleExecute" text="%interest.button.execute" styleClass="button-danger" prefWidth="150.0" disable="true" />
    </HBox>

    <VBox fx:id="previewArea" spacing="10.0" visible="false" styleClass="info-panel">
        <Label text="%interest.preview.title" style="-fx-font-weight: bold;" />
        <GridPane hgap="10.0" vgap="5.0">
            <Label text="%interest.preview.count" GridPane.rowIndex="0" GridPane.columnIndex="0" />
            <Label fx:id="countLabel" text="0" style="-fx-font-weight: bold;" GridPane.rowIndex="0" GridPane.columnIndex="1" />
            
            <Label text="%interest.preview.total" GridPane.rowIndex="1" GridPane.columnIndex="0" />
            <Label fx:id="totalAmountLabel" text="₹ 0.00" style="-fx-font-weight: bold; -fx-text-fill: #27ae60;" GridPane.rowIndex="1" GridPane.columnIndex="1" />
        </GridPane>
        <Label text="%interest.preview.warning" style="-fx-text-fill: #e67e22; -fx-font-size: 11px;" />
    </VBox>

    <VBox fx:id="statusArea" spacing="5.0" />

</VBox>
