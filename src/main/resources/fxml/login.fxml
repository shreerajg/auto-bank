<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<HBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.autobank.auth.ui.LoginController"
      styleClass="login-root"
      xmlns="http://javafx.com/javafx/22">

    <!-- Left accent panel -->
    <VBox alignment="CENTER" spacing="16" HBox.hgrow="ALWAYS"
          styleClass="login-accent-panel">
        <Label text="🏦" styleClass="login-brand-icon"/>
        <Label text="AutoBank" styleClass="login-brand-title"/>
        <Label text="Cooperative Banking System" styleClass="login-brand-subtitle"/>
        <Region prefHeight="20"/>
        <Label text="✦  Secure  ·  Reliable  ·  Offline-First  ✦" styleClass="login-brand-tagline"/>
    </VBox>

    <!-- Right login card -->
    <VBox alignment="CENTER" spacing="0" HBox.hgrow="ALWAYS"
          styleClass="login-form-panel">

        <VBox spacing="24" styleClass="login-form" maxWidth="400">
            <VBox spacing="8">
                <Label text="Welcome Back" styleClass="page-title" style="-fx-font-size: 24px;"/>
                <Label text="Sign in to your AutoBank account" styleClass="page-subtitle"/>
            </VBox>

            <VBox spacing="8">
                <Label fx:id="usernameLabel" text="USERNAME"/>
                <TextField fx:id="usernameField" promptText="Enter your username"/>
            </VBox>

            <VBox spacing="8">
                <Label fx:id="passwordLabel" text="PASSWORD"/>
                <PasswordField fx:id="passwordField" promptText="Enter your password"/>
            </VBox>

            <Label fx:id="errorLabel" styleClass="error-label" visible="false" managed="false" wrapText="true"/>

            <Button fx:id="loginButton" text="Sign In →" onAction="#handleLogin"
                    defaultButton="true" styleClass="primary-button" maxWidth="Infinity"/>

            <HBox alignment="CENTER" spacing="12">
                <Button text="English" onAction="#switchToEnglish" styleClass="lang-button"/>
                <Button text="मराठी"  onAction="#switchToMarathi"  styleClass="lang-button"/>
            </HBox>
        </VBox>

        <Label text="AutoBank v1.0  ·  Patsanstha Edition" styleClass="login-footer-text"/>
    </VBox>
</HBox>
