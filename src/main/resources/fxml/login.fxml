<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.autobank.auth.ui.LoginController"
      alignment="CENTER" spacing="20" styleClass="login-root"
      xmlns="http://javafx.com/javafx/22">

    <Label text="AutoBank" styleClass="app-title"/>
    <Label fx:id="subtitleLabel" text="Cooperative Banking System" styleClass="subtitle"/>

    <VBox spacing="10" styleClass="login-form">
        <Label fx:id="usernameLabel" text="Username"/>
        <TextField fx:id="usernameField" promptText="Enter username"/>

        <Label fx:id="passwordLabel" text="Password"/>
        <PasswordField fx:id="passwordField" promptText="Enter password"/>

        <Label fx:id="errorLabel" styleClass="error-label" visible="false" managed="false"/>

        <Button fx:id="loginButton" text="Login" onAction="#handleLogin"
                defaultButton="true" styleClass="primary-button" maxWidth="Infinity"/>
    </VBox>

    <HBox alignment="CENTER" spacing="10">
        <Button text="English" onAction="#switchToEnglish" styleClass="lang-button"/>
        <Button text="मराठी"  onAction="#switchToMarathi"  styleClass="lang-button"/>
    </HBox>
</VBox>
