<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<HBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.autobank.auth.ui.LoginController"
      styleClass="login-root"
      xmlns="http://javafx.com/javafx/22">

    <!-- Left accent panel -->
    <VBox alignment="CENTER" spacing="20" HBox.hgrow="ALWAYS"
          styleClass="login-accent-panel">
        <Label text="🏦" styleClass="login-brand-icon"/>
        <Label text="%app.title" styleClass="login-brand-title"/>
        <Label text="%app.subtitle" styleClass="login-brand-subtitle"/>
        <Region prefHeight="40"/>
        <Label text="✦  Secure  ·  Reliable  ·  Offline-First  ✦" styleClass="login-brand-tagline"/>
    </VBox>

    <!-- Right login card -->
    <VBox alignment="CENTER" spacing="0" HBox.hgrow="ALWAYS"
          styleClass="login-form-panel">

        <VBox spacing="24" styleClass="login-form" maxWidth="400">
            <VBox spacing="8">
                <Label text="%login.welcome" styleClass="page-title" style="-fx-font-size: 24px;"/>
                <Label fx:id="subtitleLabel" text="%app.subtitle" styleClass="page-subtitle"/>
            </VBox>

            <VBox spacing="8">
                <Label fx:id="usernameLabel" text="%login.username"/>
                <TextField fx:id="usernameField" promptText="%login.username"/>
            </VBox>

            <VBox spacing="8">
                <Label fx:id="passwordLabel" text="%login.password"/>
                <PasswordField fx:id="passwordField" promptText="%login.password"/>
            </VBox>

            <Label fx:id="errorLabel" styleClass="error-label" visible="false" managed="false" wrapText="true"/>

            <Button fx:id="loginButton" text="%login.button" onAction="#handleLogin"
                    defaultButton="true" styleClass="primary-button, pulse-action" maxWidth="Infinity"/>

            <HBox alignment="CENTER" spacing="12">
                <Button text="English" onAction="#switchToEnglish" styleClass="lang-button"/>
                <Button text="मराठी"  onAction="#switchToMarathi"  styleClass="lang-button"/>
            </HBox>
        </VBox>

        <Label text="%login.footer" styleClass="login-footer-text"/>
    </VBox>
</HBox>
