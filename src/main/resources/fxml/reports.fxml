<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.autobank.reports.ui.ReportController"
      spacing="16" styleClass="content-pane"
      xmlns="http://javafx.com/javafx/22">

    <HBox alignment="CENTER_LEFT" spacing="12">
        <Label text="Reports &amp; Analytics" styleClass="page-title" HBox.hgrow="ALWAYS"/>
        <Button text="⟳ Refresh" onAction="#handleRefresh" styleClass="primary-button"/>
    </HBox>

    <!-- Summary Cards -->
    <HBox spacing="12" fillHeight="true">
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <Label text="Active Accounts" styleClass="stat-label"/>
            <Label fx:id="statAccounts" text="—" styleClass="stat-value"/>
        </VBox>
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <Label text="Total Balance (₹)" styleClass="stat-label"/>
            <Label fx:id="statTotalBal" text="—" styleClass="stat-value"/>
        </VBox>
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <Label text="Total Deposits (₹)" styleClass="stat-label"/>
            <Label fx:id="statDeposits" text="—" styleClass="stat-value"/>
        </VBox>
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <Label text="Total Withdrawals (₹)" styleClass="stat-label"/>
            <Label fx:id="statWithdrawals" text="—" styleClass="stat-value"/>
        </VBox>
    </HBox>
    <HBox spacing="12">
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <Label text="Transactions" styleClass="stat-label"/>
            <Label fx:id="statTxCount" text="—" styleClass="stat-value"/>
        </VBox>
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <Label text="Active Loans" styleClass="stat-label"/>
            <Label fx:id="statActiveLoans" text="—" styleClass="stat-value"/>
        </VBox>
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <Label text="Loan Outstanding (₹)" styleClass="stat-label"/>
            <Label fx:id="statLoanOutstanding" text="—" styleClass="stat-value"/>
        </VBox>
        <VBox HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
    </HBox>

    <!-- Chart + Top Accounts -->
    <HBox spacing="16" VBox.vgrow="ALWAYS">
        <VBox HBox.hgrow="ALWAYS" spacing="8">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="Transaction Volume — Last"/>
                <ComboBox fx:id="dayRangeCombo" prefWidth="80"/>
                <Label text="days"/>
            </HBox>
            <BarChart fx:id="volumeChart" VBox.vgrow="ALWAYS">
                <xAxis><CategoryAxis fx:id="chartXAxis"/></xAxis>
                <yAxis><NumberAxis fx:id="chartYAxis"/></yAxis>
            </BarChart>
        </VBox>

        <VBox spacing="8" minWidth="320">
            <Label text="Top 10 Accounts by Balance" styleClass="section-title"/>
            <TableView fx:id="topAccountsTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colAccNum"  text="Account #"   prefWidth="110"/>
                    <TableColumn fx:id="colAccName" text="Holder"      prefWidth="160"/>
                    <TableColumn fx:id="colAccBal"  text="Balance (₹)" prefWidth="120"/>
                </columns>
            </TableView>
        </VBox>
    </HBox>

    <Label fx:id="statusLabel" styleClass="status-label" wrapText="true"/>
</VBox>
