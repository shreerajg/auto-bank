<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>

<ScrollPane fitToWidth="true"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.autobank.reports.ui.ReportController"
            xmlns="http://javafx.com/javafx/22"
            styleClass="scroll-pane">

<VBox spacing="32" style="-fx-padding: 32 40 16 40;">

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="16">
        <Label text="%reports.title" styleClass="page-title" HBox.hgrow="ALWAYS"/>
        
        <HBox spacing="12" alignment="CENTER_LEFT" style="-fx-padding: 0 20 0 0;">
            <Button text="%reports.button.balances" onAction="#handleExportBalances" styleClass="secondary-button" prefHeight="40"/>
            <Button text="%reports.button.cashbook" onAction="#handleExportCashbook" styleClass="secondary-button" prefHeight="40"/>
        </HBox>

        <Label text="%reports.label.period" style="-fx-font-weight: bold;"/>
        <ComboBox fx:id="dayRangeCombo" prefWidth="130" prefHeight="38"/>
        <Button text="%reports.button.refresh" onAction="#handleRefresh" styleClass="primary-button" prefHeight="38"/>
    </HBox>

    <!-- Stat Row 1 -->
    <HBox spacing="20">
        <VBox styleClass="stat-card, stat-card-blue" HBox.hgrow="ALWAYS" maxWidth="Infinity" spacing="12">
            <Label text="%dashboard.stats.accounts" styleClass="stat-label"/>
            <Label fx:id="statAccounts" text="—" styleClass="stat-value"/>
        </VBox>
        <VBox styleClass="stat-card, stat-card-green" HBox.hgrow="ALWAYS" maxWidth="Infinity" spacing="12">
            <Label text="%dashboard.stats.balance" styleClass="stat-label"/>
            <Label fx:id="statTotalBal" text="—" styleClass="stat-value"/>
        </VBox>
        <VBox styleClass="stat-card, stat-card-purple" HBox.hgrow="ALWAYS" maxWidth="Infinity" spacing="12">
            <Label text="%reports.stat.today_txn" styleClass="stat-label"/>
            <Label fx:id="statTodayTx" text="—" styleClass="stat-value"/>
        </VBox>
        <VBox styleClass="stat-card, stat-card-orange" HBox.hgrow="ALWAYS" maxWidth="Infinity" spacing="12">
            <Label text="%reports.stat.today_vol" styleClass="stat-label"/>
            <Label fx:id="statTodayVol" text="—" styleClass="stat-value"/>
        </VBox>
        <VBox styleClass="stat-card, stat-card-blue" HBox.hgrow="ALWAYS" maxWidth="Infinity" spacing="12">
            <Label text="%dashboard.stats.loans" styleClass="stat-label"/>
            <Label fx:id="statActiveLoans" text="—" styleClass="stat-value"/>
        </VBox>
    </HBox>

        <Label text="%reports.label.period"/>
        <ComboBox fx:id="dayRangeCombo" prefWidth="80"/>
        <Label text="%reports.label.days"/>
        <Button text="%reports.button.refresh" onAction="#handleRefresh" styleClass="primary-button"/>
    </HBox>

    <!-- Stat Row 1 -->
    <HBox spacing="10">
        <VBox styleClass="stat-card, stat-card-blue" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <Label text="%dashboard.stats.accounts" styleClass="stat-label"/>
            <Label fx:id="statAccounts" text="—" styleClass="stat-value"/>
        </VBox>
        <VBox styleClass="stat-card, stat-card-green" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <Label text="%dashboard.stats.balance" styleClass="stat-label"/>
            <Label fx:id="statTotalBal" text="—" styleClass="stat-value"/>
        </VBox>
        <VBox styleClass="stat-card, stat-card-teal" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <Label text="%reports.stat.today_txn" styleClass="stat-label"/>
            <Label fx:id="statTodayTx" text="—" styleClass="stat-value"/>
        </VBox>
        <VBox styleClass="stat-card, stat-card-purple" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <Label text="%reports.stat.today_vol" styleClass="stat-label"/>
            <Label fx:id="statTodayVol" text="—" styleClass="stat-value"/>
        </VBox>
        <VBox styleClass="stat-card, stat-card-orange" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <Label text="%reports.stat.total_txn" styleClass="stat-label"/>
            <Label fx:id="statTxCount" text="—" styleClass="stat-value"/>
        </VBox>
        <VBox styleClass="stat-card, stat-card-red" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <Label text="%dashboard.recent.type" styleClass="stat-label"/>
            <Label fx:id="statDeposits" text="—" styleClass="stat-value"/>
        </VBox>
        <VBox styleClass="stat-card, stat-card-blue" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <Label text="%dashboard.recent.type" styleClass="stat-label"/>
            <Label fx:id="statWithdrawals" text="—" styleClass="stat-value"/>
        </VBox>
        <VBox styleClass="stat-card, stat-card-orange" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <Label text="%dashboard.stats.loans" styleClass="stat-label"/>
            <Label fx:id="statActiveLoans" text="—" styleClass="stat-value"/>
        </VBox>
        <VBox styleClass="stat-card, stat-card-green" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <Label text="%reports.stat.loan_pending" styleClass="stat-label"/>
            <Label fx:id="statLoanOutstanding" text="—" styleClass="stat-value"/>
        </VBox>
    </HBox>

    <!-- Line Chart: full width -->
    <VBox styleClass="chart-card">
        <LineChart fx:id="trendChart" prefHeight="300" animated="false"
                   createSymbols="false" legendVisible="true">
            <xAxis><CategoryAxis fx:id="trendXAxis" label="%reports.chart.trend_x"/></xAxis>
            <yAxis><NumberAxis fx:id="trendYAxis" label="%reports.chart.trend_y"/></yAxis>
        </LineChart>
    </VBox>

    <!-- Row: Pie + Monthly Bar -->
    <HBox spacing="24">
        <VBox styleClass="chart-card" HBox.hgrow="ALWAYS">
            <Label text="%reports.chart.split_title" styleClass="chart-title"
                   style="-fx-padding: 0 8 0 8;"/>
            <PieChart fx:id="splitPieChart" prefHeight="300" animated="false"
                      labelsVisible="false" legendVisible="true"
                      legendSide="BOTTOM"/>
        </VBox>
        <VBox styleClass="chart-card" HBox.hgrow="ALWAYS">
            <Label text="Monthly Cash Flow" styleClass="chart-title"/>
            <BarChart fx:id="monthlyBarChart" prefHeight="300" animated="false">
                <xAxis><CategoryAxis fx:id="monthXAxis" label="%reports.chart.monthly_x"/></xAxis>
                <yAxis><NumberAxis fx:id="monthYAxis" label="%reports.chart.monthly_y"/></yAxis>
            </BarChart>
        </VBox>
    </HBox>

    <!-- Row: Loan Status Bar + Top Accounts -->
    <HBox spacing="24">
        <VBox styleClass="chart-card" minWidth="320" maxWidth="380">
            <Label text="Loan Overview" styleClass="chart-title"/>
            <BarChart fx:id="loanStatusChart" prefHeight="280" animated="false" legendVisible="false">
                <xAxis><CategoryAxis fx:id="loanXAxis" label="%reports.chart.loan_x"/></xAxis>
                <yAxis><NumberAxis fx:id="loanYAxis" label="%reports.chart.loan_y"/></yAxis>
            </BarChart>
        </VBox>

        <VBox spacing="12" HBox.hgrow="ALWAYS" styleClass="chart-card">
            <Label text="%reports.table.top_accounts" styleClass="chart-title"/>
            <TableView fx:id="topAccountsTable" prefHeight="280" VBox.vgrow="ALWAYS" styleClass="table-view">
                <columns>
                    <TableColumn fx:id="colAccNum"  text="%accounts.table.acc_no"   prefWidth="130"/>
                    <TableColumn fx:id="colAccName" text="%accounts.table.name" prefWidth="240"/>
                    <TableColumn fx:id="colAccBal"  text="%accounts.table.balance" prefWidth="140"/>
                </columns>
            </TableView>
        </VBox>
    </HBox>

    <Label fx:id="statusLabel" styleClass="status-label" wrapText="true"/>

</VBox>
</ScrollPane>
