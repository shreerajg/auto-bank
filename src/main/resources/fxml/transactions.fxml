<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<SplitPane xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.autobank.transaction.ui.TransactionController"
           dividerPositions="0.67"
           xmlns="http://javafx.com/javafx/22">

    <!-- Left: table -->
    <VBox spacing="14" styleClass="content-pane">
        <VBox spacing="3">
            <Label text="Transactions" styleClass="page-title"/>
            <Label text="Deposit and withdrawal ledger"
                   style="-fx-font-size: 12px; -fx-text-fill: #6b7280;"/>
        </VBox>

        <TableView fx:id="transactionTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId"      text="Ref #"        prefWidth="60"/>
                <TableColumn fx:id="colType"    text="Type"         prefWidth="110"/>
                <TableColumn fx:id="colAmount"  text="Amount (₹)"   prefWidth="110"/>
                <TableColumn fx:id="colBalance" text="Balance After" prefWidth="120"/>
                <TableColumn fx:id="colDesc"    text="Description"  prefWidth="200"/>
                <TableColumn fx:id="colStatus"  text="Status"       prefWidth="80"/>
            </columns>
        </TableView>
    </VBox>

    <!-- Right: form -->
    <VBox spacing="14" styleClass="content-pane form-panel">
        <Label text="New Transaction" styleClass="section-title"/>
        <Separator/>

        <VBox spacing="5">
            <Label text="SEARCH ACCOUNT"/>
            <TextField fx:id="accountSearchField" promptText="Type name or account #…"/>
        </VBox>
        <ComboBox fx:id="accountCombo" maxWidth="Infinity" promptText="Select account…"/>

        <VBox spacing="5">
            <Label text="AMOUNT (₹)"/>
            <TextField fx:id="amountField" promptText="0.00"/>
        </VBox>

        <VBox spacing="5">
            <Label text="DESCRIPTION (OPTIONAL)"/>
            <TextArea fx:id="descriptionField" promptText="Note…" prefRowCount="3"/>
        </VBox>

        <Pane VBox.vgrow="ALWAYS"/>

        <HBox spacing="10">
            <Button text="⬆  Deposit"  onAction="#handleDeposit"
                    styleClass="success-button" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            <Button text="⬇  Withdraw" onAction="#handleWithdrawal"
                    styleClass="danger-button"  HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        </HBox>
        <Label fx:id="statusLabel" styleClass="status-label" wrapText="true"/>
    </VBox>
</SplitPane>
