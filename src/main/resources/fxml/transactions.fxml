<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<SplitPane xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.autobank.transaction.ui.TransactionController"
           dividerPositions="0.65"
           style="-fx-background-color: transparent;"
           xmlns="http://javafx.com/javafx/22">

    <!-- Left: Transaction History -->
    <VBox spacing="24" styleClass="content-pane">
        <VBox spacing="6">
            <Label text="%tx.title" styleClass="page-title"/>
            <Label text="%tx.subtitle" styleClass="page-subtitle"/>
        </VBox>

        <TableView fx:id="transactionTable" VBox.vgrow="ALWAYS" styleClass="table-view">
            <columns>
                <TableColumn fx:id="colId"      text="%tx.table.ref"        prefWidth="90"/>
                <TableColumn fx:id="colType"    text="%tx.table.type"         prefWidth="130"/>
                <TableColumn fx:id="colAmount"  text="%tx.table.amount"   prefWidth="140"/>
                <TableColumn fx:id="colBalance" text="%tx.table.balance_after" prefWidth="160"/>
                <TableColumn fx:id="colDate"    text="%tx.table.datetime"     prefWidth="180"/>
                <TableColumn fx:id="colStatus"  text="%tx.table.status"       prefWidth="110"/>
            </columns>
        </TableView>
    </VBox>

    <!-- Right: Action Panel -->
    <VBox spacing="24" styleClass="content-pane, chart-card" maxWidth="450">
        <Label text="%tx.section.new" styleClass="section-title"/>
        <Separator/>

        <!-- Account Selection Card -->
        <VBox spacing="12" style="-fx-background-color: #f8fafc; -fx-padding: 20; -fx-background-radius: 12px; -fx-border-color: #e2e8f0; -fx-border-radius: 12px;">
            <VBox spacing="6">
                <Label text="%tx.label.select_account" styleClass="stat-label"/>
                <TextField fx:id="accountSearchField" promptText="%tx.label.search_acc" prefHeight="38"/>
                <ComboBox fx:id="accountCombo" maxWidth="Infinity" promptText="%tx.label.choose_acc" prefHeight="38"/>
            </VBox>
            
            <Separator style="-fx-padding: 8 0;"/>
            
            <VBox spacing="6">
                <Label fx:id="selectedAccountLabel" text="%tx.label.no_acc_selected" style="-fx-font-weight: bold; -fx-text-fill: #475569; -fx-font-size: 14px;"/>
                <Label text="%accounts.label.balance" styleClass="stat-label"/>
                <Label fx:id="balanceValueLabel" text="₹ 0.00" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
            </VBox>
        </VBox>

        <!-- Transaction Details -->
        <VBox spacing="18">
            <VBox spacing="8">
                <Label text="%tx.label.amount" styleClass="stat-label"/>
                <TextField fx:id="amountField" promptText="%tx.label.amount" prefHeight="48" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
            </VBox>

            <VBox spacing="8">
                <Label text="%tx.label.remarks" styleClass="stat-label"/>
                <TextArea fx:id="descriptionField" promptText="%tx.label.remarks" prefHeight="90" wrapText="true"/>
            </VBox>
        </VBox>

        <Region VBox.vgrow="ALWAYS"/>

        <!-- Action Buttons -->
        <VBox spacing="12">
            <HBox spacing="12">
                <Button text="%tx.button.deposit"  onAction="#handleDeposit"
                        styleClass="success-button" HBox.hgrow="ALWAYS" maxWidth="Infinity" prefHeight="50"/>
                <Button text="%tx.button.withdraw" onAction="#handleWithdrawal"
                        styleClass="danger-button"  HBox.hgrow="ALWAYS" maxWidth="Infinity" prefHeight="50"/>
            </HBox>
            <Button text="Clear Form" onAction="#handleClearForm"
                    styleClass="secondary-button" maxWidth="Infinity" prefHeight="40"/>
            <Label fx:id="statusLabel" alignment="CENTER" maxWidth="Infinity" style="-fx-font-weight: bold; -fx-font-size: 13px;"/>
        </VBox>
    </VBox>
</SplitPane>
