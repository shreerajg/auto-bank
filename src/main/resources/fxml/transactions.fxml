<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<SplitPane xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.autobank.transaction.ui.TransactionController"
           dividerPositions="0.65"
           style="-fx-background-color: #f0f2f5;"
           xmlns="http://javafx.com/javafx/22">

    <!-- Left: Transaction History -->
    <VBox spacing="20" styleClass="content-pane">
        <VBox spacing="4">
            <Label text="%tx.title" styleClass="page-title"/>
            <Label text="%tx.subtitle" styleClass="page-subtitle"/>
        </VBox>

        <TableView fx:id="transactionTable" VBox.vgrow="ALWAYS" styleClass="chart-card">
            <columns>
                <TableColumn fx:id="colId"      text="%tx.table.ref"        prefWidth="70"/>
                <TableColumn fx:id="colType"    text="%tx.table.type"         prefWidth="110"/>
                <TableColumn fx:id="colAmount"  text="%tx.table.amount"   prefWidth="120"/>
                <TableColumn fx:id="colBalance" text="%tx.table.balance_after" prefWidth="130"/>
                <TableColumn fx:id="colDate"    text="%tx.table.datetime"     prefWidth="140"/>
                <TableColumn fx:id="colStatus"  text="%tx.table.status"       prefWidth="90"/>
            </columns>
        </TableView>
    </VBox>

    <!-- Right: Action Panel -->
    <VBox spacing="20" styleClass="content-pane, chart-card" maxWidth="450">
        <Label text="%tx.section.new" styleClass="section-title"/>
        <Separator/>

        <!-- Account Selection Card -->
        <VBox spacing="10" style="-fx-background-color: #f8fafc; -fx-padding: 15; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8;">
            <VBox spacing="4">
                <Label text="%tx.label.select_account" styleClass="stat-label"/>
                <TextField fx:id="accountSearchField" promptText="%tx.label.search_acc" prefHeight="35"/>
                <ComboBox fx:id="accountCombo" maxWidth="Infinity" promptText="%tx.label.choose_acc" prefHeight="35"/>
            </VBox>
            
            <Separator style="-fx-padding: 5 0;"/>
            
            <VBox spacing="4">
                <Label fx:id="selectedAccountLabel" text="%tx.label.no_acc_selected" style="-fx-font-weight: bold; -fx-text-fill: #475569;"/>
                <Label text="%accounts.label.balance" styleClass="stat-label"/>
                <Label fx:id="balanceValueLabel" text="₹ 0.00" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
            </VBox>
        </VBox>

        <!-- Transaction Details -->
        <VBox spacing="15">
            <VBox spacing="6">
                <Label text="%tx.label.amount" styleClass="stat-label"/>
                <TextField fx:id="amountField" promptText="%tx.label.amount" prefHeight="45" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            </VBox>

            <VBox spacing="6">
                <Label text="%tx.label.remarks" styleClass="stat-label"/>
                <TextArea fx:id="descriptionField" promptText="%tx.label.remarks" prefHeight="70" wrapText="true"/>
            </VBox>
        </VBox>

        <Region VBox.vgrow="ALWAYS"/>

        <!-- Action Buttons -->
        <VBox spacing="10">
            <HBox spacing="10">
                <Button text="%tx.button.deposit"  onAction="#handleDeposit"
                        styleClass="success-button" HBox.hgrow="ALWAYS" maxWidth="Infinity" prefHeight="50"/>
                <Button text="%tx.button.withdraw" onAction="#handleWithdrawal"
                        styleClass="danger-button"  HBox.hgrow="ALWAYS" maxWidth="Infinity" prefHeight="50"/>
            </HBox>
            <Label fx:id="statusLabel" alignment="CENTER" maxWidth="Infinity" style="-fx-font-weight: bold;"/>
        </VBox>
    </VBox>
</SplitPane>
